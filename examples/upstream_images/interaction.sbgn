<?xml version='1.0' encoding='utf-8'?>
<sbgn xmlns="http://sbgn.org/libsbgn/0.3">
  <map id="upstream_interaction" language="entity relationship">
    <glyph id="binary_a" class="entity">
      <label text="A" />
