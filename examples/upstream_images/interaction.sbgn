    <arc id="binary" class="interaction" source="binary_a" target="binary_b">
      <glyph id="binary_outcome" class="outcome">
        <bbox x="205" y="54.5" w="16" h="16" />
      </glyph>
      <start x="140" y="62.5" />
      <end x="285" y="62.5" />
