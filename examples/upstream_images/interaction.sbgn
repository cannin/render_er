        <bbox x="570" y="102" w="40" h="18" />
      </glyph>
      <start x="550" y="90" />
      <next x="550" y="135" />
      <next x="610" y="135" />
      <end x="610" y="90" />
    </arc>
    <arcgroup class="interaction">
      <glyph id="cardinality_interaction" class="interaction">
        <bbox x="195" y="257.5" w="40" h="40" />
