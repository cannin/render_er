<?xml version='1.0' encoding='utf-8'?>
<sbgn xmlns="http://sbgn.org/libsbgn/0.3">
  <map id="upstream_nesting_existence" language="entity relationship">
    <glyph id="left_x" class="entity">
      <label text="X" />
      <bbox x="20" y="170" w="310" h="135" />
      <glyph id="left_a" class="entity">
        <label text="A" />
        <bbox x="40" y="220" w="120" h="60" />
        <glyph id="left_variable_a" class="existence">
          <bbox x="88" y="208" w="24" h="24" />
        </glyph>
      </glyph>
      <glyph id="left_b" class="entity">
        <label text="B" />
        <bbox x="190" y="220" w="120" h="60" />
      </glyph>
    </glyph>
    <glyph id="left_value" class="variable value">
      <label text="F" />
      <bbox x="140" y="55" w="70" h="34" />
    </glyph>
    <glyph id="right_x" class="entity">
      <label text="X" />
      <bbox x="390" y="170" w="310" h="135" />
      <glyph id="right_a" class="entity">
        <label text="A" />
        <bbox x="410" y="220" w="120" h="60" />
