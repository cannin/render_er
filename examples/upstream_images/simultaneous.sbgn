<?xml version='1.0' encoding='utf-8'?>
<sbgn xmlns="http://sbgn.org/libsbgn/0.3">
  <map id="upstream_simultaneous" language="entity relationship">
    <glyph id="entity" class="entity">
      <label text="Entity" />
      <bbox x="190" y="20" w="180" h="80" />
      <glyph id="state" class="state variable">
        <state variable="state" />
        <bbox x="268" y="88" w="24" h="24" />
      </glyph>
    </glyph>
    <glyph id="value" class="variable value">
      <label text="value" />
      <bbox x="245" y="155" w="70" h="34" />
    </glyph>
    <glyph id="target_a" class="phenotype">
      <label text="Outcome A" />
      <bbox x="25" y="365" w="150" h="60" />
    </glyph>
    <glyph id="target_b" class="phenotype">
      <label text="Outcome B" />
      <bbox x="205" y="405" w="150" h="60" />
    </glyph>
    <glyph id="target_c" class="phenotype">
      <label text="Outcome C" />
      <bbox x="385" y="365" w="150" h="60" />
    </glyph>
    <arc id="assignment" class="assignment" source="value" target="state">
      <glyph id="event" class="outcome">
        <bbox x="272" y="126" w="16" h="16" />
      </glyph>
      <start x="280" y="155" />
      <end x="280" y="112" />
    </arc>
    <arc id="influence_0" class="necessary stimulation" source="event" target="target_a">
      <start x="280" y="142" />
      <next x="280" y="260" />
      <next x="100.0" y="310" />
      <end x="100.0" y="365" />
    </arc>
    <arc id="influence_1" class="stimulation" source="event" target="target_b">
      <start x="280" y="142" />
      <next x="280" y="260" />
      <next x="280.0" y="310" />
      <end x="280.0" y="405" />
    </arc>
    <arc id="influence_2" class="inhibition" source="event" target="target_c">
      <start x="280" y="142" />
      <next x="280" y="260" />
      <next x="460.0" y="310" />
      <end x="460.0" y="365" />
    </arc>
  </map>
</sbgn>